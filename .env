# Скопировать в .env и заполнить

# PostgreSQL
POSTGRES_USER=hh_user
POSTGRES_PASSWORD=hh_local_dev_password_2026
POSTGRES_DB=hh_autoapply

# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=a40f1adfe790b426b6d1facdd18e38e186be21758145d0fb3c92204c4d9f8497

# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=4fYIW12gvbtbhGUE11MTJ1h7-ARP2M_B41iXbAebO2Y=

# Kafka (опционально, значения по умолчанию)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_JOBS=apply-jobs
KAFKA_TOPIC_RESULTS=apply-results

# Worker
WORKER_HEADLESS=true
CHROMIUM_BINARY=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Учётные данные hh.ru теперь задаются каждым пользователем
# через веб-интерфейс (PUT /api/settings) и хранятся в БД в зашифрованном
# виде (Fernet). HH_LOGIN/HH_PASSWORD из .env больше не читаются.

# JWT настройки
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Дополнительные настройки (опционально)
DEBUG=false
